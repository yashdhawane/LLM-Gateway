# Copy to .env and adjust locally. Never commit .env.

# Neon PostgreSQL pooled connection string
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"

# Server
PORT=3000
NODE_ENV=development

# Auth (use a long random value, at least 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Optional: required only when using the OpenAI provider
OPENAI_API_KEY=

# Optional: required only when using the Anthropic provider
ANTHROPIC_API_KEY=
