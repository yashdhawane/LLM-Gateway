# Copy to .env and adjust locally. Never commit .env.

# Neon PostgreSQL pooled connection string (application runtime).
#
# Neon's pooler is PgBouncer in transaction mode, and Prisma Client uses named
# prepared statements. The pooler flag is required: without it, multi-column
# writes (request finalization) can fail with
#   ConnectorError(QueryError(UnexpectedMessage))
# which leaves the request row PROCESSING until the 15-minute stale sweep marks
# it ABANDONED. Verified against a disposable Neon branch: `pgbouncer=true`
# passes every check, and `statement_cache_size=0` is an equivalent alternative.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1"
#
# Migrations (`prisma migrate deploy`) cannot run through the pooler: Prisma
# Migrate needs a single session. Run the CLI with DATABASE_URL pointed at the
# direct (unpooled) host instead, i.e. the same string without "-pooler" and
# without `pgbouncer=true`:
#   DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require" npx prisma migrate deploy

# Server
PORT=3000
NODE_ENV=development

# Auth (use a long random value, at least 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Optional: required only when using the OpenAI provider
OPENAI_API_KEY=

# Optional: required only when using the Anthropic provider
ANTHROPIC_API_KEY=
