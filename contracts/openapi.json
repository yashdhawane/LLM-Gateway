  "info": {
    "title": "LLM Gateway API",
    "description": "OpenAI-compatible text chat gateway. `/chat/completions` answers one JSON object, or a `text/event-stream` when `stream: true`. Unsupported request features return a structured UNSUPPORTED_FEATURE error.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "type": "http",
        "description": "Enter your API key"
      },
      "jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter the JWT returned by /auth/login or /auth/signup"
      }
    },
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "strong-password",
            "minLength": 8
          },
          "name": {
            "type": "string",
            "example": "Yash"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Unsupported request field."
          },
          "type": {
            "type": "string",
            "enum": [
              "invalid_request_error",
              "authentication_error",
              "permission_error",
              "not_found_error",
              "conflict_error",
              "rate_limit_error",
              "server_error"
            ],
            "example": "invalid_request_error"
          },
          "param": {
            "type": "object",
            "nullable": true,
            "example": null,
            "description": "Request field that caused the error, when applicable."
          },
          "code": {
            "type": "string",
            "example": "UNSUPPORTED_FEATURE"
          },
          "trace_id": {
            "type": "string",
            "example": "0f6f3d9d-5b6f-4b7e-9c2a-1f6f3d9d5b6f"
          },
          "status_code": {
            "type": "number",
            "example": 400
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-24T15:20:16.452Z"
          }
        },
        "required": [
          "message",
          "type",
          "param",
          "code",
          "status_code",
          "timestamp"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetailDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "strong-password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "my-app"
          }
        }
      },
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "developer"
            ],
            "example": "user"
          },
          "content": {
            "type": "string",
            "example": "Hello from my application"
          },
          "name": {
            "type": "string",
            "example": "user-123"
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "StreamOptionsDto": {
        "type": "object",
        "properties": {
          "include_usage": {
            "type": "boolean",
            "example": true,
            "description": "Emit one extra chunk carrying usage before the stream ends. Without it no usage is sent, but the gateway still records the tokens it received."
          }
        }
      },
      "ChatCompletionRequestDto": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "example": "mock"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageDto"
            }
          },
          "temperature": {
            "type": "number",
            "example": 0.7,
            "minimum": 0,
            "maximum": 2
          },
          "top_p": {
            "type": "number",
            "example": 1,
            "minimum": 0,
            "maximum": 1
          },
          "n": {
            "type": "number",
            "example": 1,
            "description": "Only n=1 is supported. Other values return UNSUPPORTED_FEATURE."
          },
          "stream": {
            "type": "boolean",
            "example": false,
            "description": "When true the response is text/event-stream: OpenAI-compatible chat.completion.chunk objects, terminated by data: [DONE]."
          },
          "stream_options": {
            "description": "Only valid with stream: true. include_usage appends one final chunk with choices: [] and the token usage.",
            "allOf": [
              {
                "$ref": "#/components/schemas/StreamOptionsDto"
              }
            ]
          },
          "stop": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": [
              "END"
            ]
          },
          "max_tokens": {
            "type": "number",
            "example": 256
          },
          "max_completion_tokens": {
            "type": "number",
            "example": 256
          },
          "presence_penalty": {
            "type": "number",
            "example": 0,
            "minimum": -2,
            "maximum": 2
          },
          "frequency_penalty": {
            "type": "number",
            "example": 0,
            "minimum": -2,
            "maximum": 2
          },
          "logit_bias": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "example": {
              "50256": -100
            }
          },
          "user": {
            "type": "string",
            "example": "end-user-123"
          },
          "seed": {
            "type": "number",
            "example": 42
          },
          "timeout": {
            "type": "number",
            "example": 30000,
            "description": "Gateway-specific timeout in milliseconds."
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "ChatCompletionResponseMessageDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "example": "assistant"
          },
          "content": {
            "type": "string",
            "example": "Hello! How can I help?"
          }
        },
        "required": [
          "role"
        ]
      },
      "ChatCompletionChoiceDto": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/ChatCompletionResponseMessageDto"
          },
          "finish_reason": {
            "type": "object",
            "example": "stop",
            "nullable": true
          }
        },
        "required": [
          "index",
          "message",
          "finish_reason"
        ]
      },
      "ChatCompletionUsageDto": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "number",
            "example": 12
          },
          "completion_tokens": {
            "type": "number",
            "example": 20
          },
          "total_tokens": {
            "type": "number",
            "example": 32
          }
        }
      },
      "ChatCompletionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "chatcmpl_mock_1761319216452"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "number",
            "example": 1761319216
          },
          "model": {
            "type": "string",
            "example": "mock"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatCompletionChoiceDto"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/ChatCompletionUsageDto"
          },
          "trace_id": {
            "type": "string",
            "example": "0f6f3d9d-5b6f-4b7e-9c2a-1f6f3d9d5b6f"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices"
        ]
      },
      "ModelDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "mock"
          },
          "object": {
            "type": "string",
            "example": "model"
          },
          "created": {
            "type": "number",
            "example": 1761319216
          },
          "owned_by": {
            "type": "string",
            "example": "mock"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "owned_by"
        ]
      },
      "ModelListDto": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "example": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelDto"
            }
          }
        },
        "required": [
          "object",
          "data"
        ]
      }
    }
  }
}
