# Copy to .env and adjust locally. Never commit .env.

# Neon PostgreSQL connection string (application runtime).
#
# Use the DIRECT endpoint for a single long-running instance (no `-pooler`):
# one process, a long-lived pool, and prepared statements stay enabled - one
# round trip per query instead of about five. A 0.25 CU compute allows 104
# direct connections, so two is plenty.
DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require&connection_limit=2"
#
# Behind the pooled endpoint (`...-pooler...`), `pgbouncer=true` is mandatory:
# Neon's pooler is PgBouncer in transaction mode and Prisma Client uses named
# prepared statements. Without it, multi-column writes (request finalization)
# can fail with
#   ConnectorError(QueryError(UnexpectedMessage))
# which leaves the request row PROCESSING until the stale sweep marks it
# ABANDONED. `statement_cache_size=0` is equivalent. The flag is not free: it
# disables the statement cache, so every query costs ~5 round trips (about 1 s
# from India to us-east-2, versus ~210 ms direct). Use the pooler only for
# serverless or many-instance deployments:
#   DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1"
#
# Migrations (`prisma migrate deploy`) always need the direct host: Prisma
# Migrate requires a single session.
#   DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require" npx prisma migrate deploy

# Server
PORT=3000
NODE_ENV=development
# Swagger UI at /docs. Local development only: leave this false (or unset) on
# any instance reachable from the internet, because it publishes the full API
# surface and every schema.
SWAGGER_ENABLED=false

# Auth (use a long random value, at least 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Optional: required only when using the OpenAI provider
OPENAI_API_KEY=

# Optional: required only when using the Anthropic provider
ANTHROPIC_API_KEY=
